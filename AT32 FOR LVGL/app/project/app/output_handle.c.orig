#define TABLE_SIZE (sizeof(adc_table) / sizeof(adc_table[0]))

float NTC_GetTemperature(uint16_t adc_value)
{

    if (adc_value >= adc_table[0])
    {
        return (float)temp_table[0];
    }
    if (adc_value <= adc_table[TABLE_SIZE - 1])
    {
        return (float)temp_table[TABLE_SIZE - 1];
    }

    uint16_t left = 0, right = TABLE_SIZE - 1;
    uint16_t mid;
    while (left <= right)
    {
        mid = (left + right) / 2;
        if (adc_table[mid] == adc_value)
        {
            return (float)temp_table[mid];
        }
        else if (adc_table[mid] > adc_value)
        {
            left = mid + 1;
        }
        else
        {
            right = mid - 1;
        }
    }

    uint16_t adc_high = adc_table[left - 1];
    uint16_t adc_low = adc_table[left];
    int16_t t_high = temp_table[left - 1];
    int16_t t_low = temp_table[left];

    float fraction = (float)(adc_high - adc_value) / (adc_high - adc_low);
    return t_high + fraction * (t_low - t_high);
}

int16_t NTC_GetTemperatureInt(uint16_t adc_value)
{

    if (adc_value >= adc_table[0])
    {
        return temp_table[0];
    }
    if (adc_value <= adc_table[TABLE_SIZE - 1])
    {
        return temp_table[TABLE_SIZE - 1];
    }

    uint16_t left = 0, right = TABLE_SIZE - 1;
    uint16_t mid;
    while (left <= right)
    {
        mid = (left + right) / 2;
        if (adc_table[mid] == adc_value)
        {
            return temp_table[mid];
        }
        else if (adc_table[mid] > adc_value)
        {
            left = mid + 1;
        }
        else
        {
            right = mid - 1;
        }
    }

    uint16_t adc_high = adc_table[left - 1];
    uint16_t adc_low = adc_table[left];
    int16_t t_high = temp_table[left - 1];
    int16_t t_low = temp_table[left];

    int32_t numerator = (int32_t)(t_low - t_high) * (adc_high - adc_value);
    int32_t denominator = (adc_high - adc_low);

    int16_t delta = (int16_t)((numerator + denominator / 2) / denominator);
    return t_high + delta;
}

void fan_output(void)
{

    static FanOutputLevel_e last_fan_output_level = 5;

    sps3006.ntc_temp = NTC_GetTemperatureInt(sps3006.ntc_temperature);

    if (sps3006.ntc_temp < 300)
    {
        sps3006.fan_output_level = LOW_SPEED;
    }
    else if (sps3006.ntc_temp >= 350 && sps3006.ntc_temp <= 450)
    {
        sps3006.fan_output_level = MEDIUM_SPEED;
    }
    else if (sps3006.ntc_temp >= 500)
    {
        sps3006.fan_output_level = HIGH_SPEED;
    }

    if (last_fan_output_level != sps3006.fan_output_level)
    {
        switch (sps3006.fan_output_level)
        {

        case LOW_SPEED:
            tmr_channel_value_set(TMR4, TMR_SELECT_CHANNEL_1, MIN_FAN_OUTPUT);
            break;
        case MEDIUM_SPEED:
            tmr_channel_value_set(TMR4, TMR_SELECT_CHANNEL_1, HALF_FAN_OUTPUT);
            break;
        case HIGH_SPEED:
            tmr_channel_value_set(TMR4, TMR_SELECT_CHANNEL_1, MAX_FAN_OUTPUT);
            break;
        }

        last_fan_output_level = sps3006.fan_output_level;
    }
}

void check_amt(void)
{
	#if 1
    static uint8_t last_amt_sgn = 1;
    static uint8_t current_amt_sgn = 0;
    static uint8_t check_step = 0;
    static uint8_t switch_time = 0;
    current_amt_sgn = gpio_input_data_bit_read(AMT_SGN_GPIO_PORT, AMT_SGN_PIN);
     
    switch (check_step)
    {
    case 0:
        if (last_amt_sgn != current_amt_sgn)
        {
            if (!current_amt_sgn)
            {
                check_step = 1;
                switch_time = 0;
                break;
            }
            else
            {
                 
                    check_step = 3;
                    break;
               
            }
            last_amt_sgn = current_amt_sgn;
        }
        break;
    case 1:
       
        switch_time++;
        if (switch_time >= 4)
        {
            switch_time = 0;
            check_step = 2;
        }
        break;
    case 2:
		
        if (!switch_time)
            gpio_bits_set(RELAY_CRT_GPIO_PORT, RELAY_CRT_PIN);
        switch_time++;
        if (switch_time >= 4)
        {
             
            switch_time = 0;
            check_step = 0;
			sps3006.amt_state = AMT_EXIST;
        }
        break;
    case 3:
        sps3006.amt_state = AMT_NOT_EXIST;
        sps3006.amt_current_range = AMT_GANGE_5A;
        gpio_bits_reset(RELAY_CRT_GPIO_PORT, RELAY_CRT_PIN);
	    check_step = 0;
        break;
    default:
        break;
    }
	#endif 
    
	
}
void set_amt_range(void)
{
    static uint8_t last_amt_range = 5;
    if (last_amt_range != sps3006.amt_current_range)
    {
        switch (sps3006.amt_current_range)
        {
        case AMT_GANGE_500MA:
            gpio_bits_set(REL_AMT_GPIO_PORT, REL_AMT_PIN);
            break;
        case AMT_GANGE_5A:
            gpio_bits_reset(REL_AMT_GPIO_PORT, REL_AMT_PIN);
            break;
        }
        last_amt_range = sps3006.amt_current_range;
    }
}

