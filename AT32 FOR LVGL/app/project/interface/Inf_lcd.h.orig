#ifndef __INF_LCD_H
#define __INF_LCD_H

#ifdef __cplusplus
extern "C"
{
#endif

#include "at32f403a_407.h"
#include <stdio.h>
#include <math.h>
#include "wk_system.h"
#include "FreeRTOS.h"
#include "queue.h"

/*============================================================================
 *                          USER CONFIGURATION
 *============================================================================*/

/**
 * @brief  Select LCD data bus width.
 *        0: 16‑bit mode (default and recommended for RGB565)
 *        1: 8‑bit mode (not recommended for images)
 */
#define LCD_USE8BIT_MODEL 0

/*============================================================================
 *                 XMC ADDRESS MAPPING (COMMAND / DATA)
 *============================================================================*/

/**
 * @defgroup XMC_lcd_address_of_data_and_command
 * @{
 */

/** Command address – A16 = 0 */
#define XMC_LCD_COMMAND (0x60000000)

/** Data address – A16 = 1 (0x20000 = 131072 = 2^17) */
#define XMC_LCD_DATA (0x60000000 | 0x20000)

/**
 * @}
 */

/*============================================================================
 *                           DMA CONFIGURATION
 *============================================================================*/

/** DMA channel used for LCD data transfers */
#define LCD_DMA_CHANNEL DMA1_CHANNEL3
#define LCD_DMA_IRQn DMA1_Channel3_IRQn
#define LCD_DMA_IRQHandler DMA1_Channel3_IRQHandler

/*============================================================================
 *                         HARDWARE RESET LINE
 *============================================================================*/

/**
 * @defgroup XMC_lcd_reset_line
 * @{
 */

/** Drive LCD reset pin high (release reset) */
#define LCD_RESET_HIGH gpio_bits_set(GPIOB, GPIO_PINS_14)

/** Drive LCD reset pin low (assert reset) */
#define LCD_RESET_LOW gpio_bits_reset(GPIOB, GPIO_PINS_14)

/**
 * @}
 */

/*============================================================================
 *                           COLOR DEFINITIONS
 *============================================================================*/

/** Color definitions in RGB565 format (5 bits red, 6 bits green, 5 bits blue) */
#define WHITE 0xFFFF
#define BLACK 0x0000
#define BLUE 0x001F
#define BRED 0xF81F
#define GRED 0xFFE0
#define GBLUE 0x07FF
#define RED 0xF800
#define MAGENTA 0xF81F
#define GREEN 0x07E0
#define CYAN 0x7FFF
#define YELLOW 0xFFE0
#define BROWN 0xBC40
#define BRRED 0xFC07
#define GRAY 0x8430

    /*============================================================================
     *                         DISPLAY ORIENTATION
     *============================================================================*/

    /**
     * @brief  Display direction enumeration.
     */
    typedef enum
    {
        LCD_DIRECTION_PORTRAIT = 0, /**< Portrait mode (width < height) */
        LCD_DIRECTION_LANDSCAPE = 1 /**< Landscape mode (width > height) */
    } LCD_DirectionType;

    /**
     * @brief  LCD information structure – used globally.
     */
    typedef struct
    {
        uint16_t width;              /**< Screen width in pixels */
        uint16_t height;             /**< Screen height in pixels */
        uint16_t id;                 /**< LCD controller ID (e.g., 0x9806) */
        LCD_DirectionType direction; /**< Current orientation (portrait/landscape) */
        uint8_t scan_mode;           /**< Current scanning direction (see LCD_SCAN_xxx) */
    } LCD_InfoType;

    /*============================================================================
     *                             FONT SIZES
     *============================================================================*/

    /**
     * @brief  Supported ASCII font sizes.
     * @note   The enum values correspond to internal font arrays in lcdfont.h.
     */
    typedef enum
    {
        FONT_12X6,  /**< 12 pixels high, 6 pixels wide */
        FONT_16X8,  /**< 16 pixels high, 8 pixels wide */
        FONT_24X12, /**< 24 pixels high, 12 pixels wide */
        FONT_32X16, /**< 32 pixels high, 16 pixels wide */
        FONT_40X20, /**< 40 pixels high, 20 pixels wide */
        FONT_64X32,
        FONT_80X40,
    } AsciiFontSize;

    /*============================================================================
     *                         IMAGE INFORMATION
     *============================================================================*/

    /**
     * @brief  Structure describing an image stored in external SPI Flash.
     */
    typedef struct
    {
        uint32_t addr;   /**< Start address of the image in Flash */
        uint16_t width;  /**< Image width in pixels */
        uint16_t height; /**< Image height in pixels */
    } PicInfo;

    /**
     * @brief  Image ID enumeration (matches g_picInfo table order).
     */
    typedef enum
    {
        PIC_LOGO,                           /**< logo */
        PIC_CURVE_VOLTAGE_CN,                  /**< 曲线界面-电压图标-中文 */                                             
        PIC_CURVE_VOLTAGE_EN,                  /**< 曲线界面-电压图标-英文 */                                   
        PIC_CURVE_CURRENT_CN,                   /**< 曲线界面-电流图标-中文 */                    
        PIC_CURVE_CURRENT_EN,                    /**< 曲线界面-电流图标-英文 */                                    
        PIC_CURVE_RECORD_CN,                     /**< 曲线界面-录制图标-中文 */                                      
        PIC_CURVE_RECORD_EN,                   /**< 曲线界面-录制图标-英文 */                                        
        PIC_CURVE_PAUSE_CN,                    /**< 曲线界面-暂停图标-中文 */                                     
        PIC_CURVE_PAUSE_EN,                    /**< 曲线界面-暂停图标-英文 */                                   
        PIC_CURVE_PLAY_CN,                  /**< 曲线界面-播放图标-英文 */                                    
        PIC_CURVE_PLAY_EN,                  /**< 曲线界面-播放图标-中文 */                                    
        PIC_CURVE_REPLAY_CN,                /**< 曲线界面-回放图标-英文 */                                   
        PIC_CURVE_REPLAY_EN,               /**< 曲线界面-回放图标-英文 */                     
        PIC_VALUE_POWER_CN,                /**< 数值界面-功率图标-中文 */                   
        PIC_VALUE_POWER_EN,                /**< 数值界面-功率图标-英文 */                         
        PIC_VALUE_VOLTAGE_CN,              /**< 数值界面-电压图标-中文 */                    
        PIC_VALUE_VOLTAGE_EN,              /**< 数值界面-电压图标-英文 */                         
        PIC_VALUE_CURRENT_CN,              /**< 数值界面-电流图标-中文 */                       
        PIC_VALUE_CURRENT_EN,              /**< 数值界面-电流图标-英文 */                          
        PIC_CHARGE_TYPEC,                  /**< 充电界面-typec图标 */                              
        PIC_CHARGE_USBA,                   /**< 充电界面-usba图标 */                            
        PIC_SETTING_WORKMODE_CN,          /**< 设置界面-工作模式图标-中文 */               
        PIC_SETTING_WORKMODE_EN,       /**< 设置界面-工作模式图标-英文 */                
        PIC_SETTING_SOUND_CN,          /**< 设置界面-声音设置图标-中文 */               
        PIC_SETTING_SOUND_EN,         /**< 设置界面-声音设置图标-英文 */                  
        PIC_SETTING_LANGUAGE_CN,         /**< 设置界面-设置中文语言 */                 
        PIC_SETTING_LANGUAGE_EN,       /**< 设置界面-设置英文语言 */                          
        PIC_SETTING_KEY_OUTPUT_CN,       /**< 设置界面-按键输出图标-中文 */                      
        PIC_SETTING_KEY_OUTPUT_EN,     /**< 设置界面-按键输出图标-英文 */                     
        PIC_SETTING_RESET_CN,                   /**< 设置界面-恢复出厂设置图标-中文 */                 
        PIC_SETTING_RESET_EN,                      /**< 设置界面-恢复出厂设置图标-英文 */              
        PIC_SETTING_SUPPORT_CN,                    /**< 设置界面-技术支持图标-英文 */                     
        PIC_SETTING_SUPPORT_EN,                    /**< 设置界面-技术支持图标-英文 */                   
        PIC_SET_WORKMODE_CN,                      /**< 设置工作模式-中文 */                            
        PIC_SET_WORKMODE_EN,             /**< 设置工作模式-英文 */                         
        PIC_SET_SOUND_CN,               /**< 设置声音-中文 */                            
        PIC_SET_SOUND_EN,                 /**< 设置声音-英文 */                               
        PIC_SET_CHINESE,                     /**< 设置中文 */                                  
        PIC_SET_ENGLISH,                   /**< 设置英文 */                                      
        PIC_OUTPUT_KEY_SETTING_CN,                 /**< 设置按键输出模式-中文 */                       
        PIC_OUTPUT_KEY_SETTING_EN,              /**< 设置按键输出模式-英文 */                     
        PIC_RESET_UNSELECTED_CN,       /**< 取消选中恢复出厂设置-中文 */                      
        PIC_RESET_UNSELECTED_EN,     /**< 取消选中恢复出厂设置-英文 */                        
        PIC_RESET_SELECTED_CN,       /**< 选中恢复出厂设置-中文 */                         
        PIC_RESET_SELECTED_EN,     /**< 选中恢复出厂设置-英文 */                           
        PIC_RESET_DONE_CN,              /**< 已恢复出厂设置-中文 */                           
        PIC_RESET_DONE_EN,    /**< 已恢复出厂设置-英文 */                      
        PIC_TECH_SUPPORT_CN,     /**< 技术支持-中文 */                            
        PIC_TECH_SUPPORT_EN,   /**< 技术支持-英文 */                           
        PIC_TOP_STATUS_BAR,                          /**< 顶部状态栏 */                              
        PIC_BOTTOM_STATUS_BAR,                  /**< 底部状态栏 */                                                   
        PIC_CURVE_INTERFACE_SELECTED_CN,                           /**< 选中曲线界面-中文 */                           
        PIC_CURVE_INTERFACE_SELECTED_EN,               /**< 选中曲线界面-英文 */                           
        PIC_CURVE_INTERFACE_UNSELECTED_CN,                        /**< 取消选中曲线界面-中文 */                       
        PIC_CURVE_INTERFACE_UNSELECTED_EN,                      /**< 取消选中曲线界面-英文 */                       
        PIC_VALUE_INTERFACE_SELECTED_CN,                      /**< 选中数值界面-中文 */                 
        PIC_VALUE_INTERFACE_SELECTED_EN,                         /**< 选中数值界面-英文 */                           
        PIC_VALUE_INTERFACE_UNSELECTED_CN,                           /**< 取消选中数值界面-中文 */                                      
		PIC_VALUE_INTERFACE_UNSELECTED_EN,                                   /**< 取消选中数值界面-英文 */                              
		PIC_CHARGE_INTERFACE_SELECTED_CN,                                    /**< 选中充电检测界面-中文 */           
		PIC_CHARGE_INTERFACE_SELECTED_EN,                                    /**< 选中充电检测界面-英文 */ 
		PIC_CHARGE_INTERFACE_UNSELECTED_CN,                                    /**< 取消选中充电检测界面-中文 */
		PIC_CHARGE_INTERFACE_UNSELECTED_EN,                                    /**< 取消选中充电检测界面-英文 */
		PIC_SETTING_INTERFACE_SELECTED_CN,                                    /**< 选中设置界面-中文 */ 
		PIC_SETTING_INTERFACE_SELECTED_EN,                                    /**< 选中设置界面-英文 */ 
		PIC_SETTING_INTERFACE_UNSELECTED_CN,                                    /**< 取消选中设置界面-中文 */
		PIC_SETTING_INTERFACE_UNSELECTED_EN,                                    /**< 取消选中设置界面-英文 */
		PIC_MODEL,                                    /**< 型号 */
		PIC_OPTION_01,                                    /**< 选项1 */
		PIC_OPTION_02,                                    /**< 选项2 */
		PIC_VOLUME,                                    /**< 音量 */
		PIC_MUTE,                                    /**< 静量 */
		
        PIC_NUM                             /**< 总图标数量（必须为最后一项） */
    } PicID;

/** Size of buffer used when reading from Flash – must align with SPI Flash block size (4KB typical) */
#define FLASH_READ_BLOCK_SIZE 4096

    /*============================================================================
     *                       DISPLAY DIMENSIONS
     *============================================================================*/

#define LCD_PORTRAIT_WIDTH 480   /**< Portrait screen width (pixels) */
#define LCD_PORTRAIT_HEIGHT 854  /**< Portrait screen height (pixels) */
#define LCD_LANDSCAPE_WIDTH 854  /**< Landscape screen width (pixels) */
#define LCD_LANDSCAPE_HEIGHT 480 /**< Landscape screen height (pixels) */

    /*============================================================================
     *                       DISPLAY MODE SELECTION
     *============================================================================*/

#define LCD_DISPLAY_PORTRAIT 0  /**< Portrait mode (480x854) */
#define LCD_DISPLAY_LANDSCAPE 1 /**< Landscape mode (854x480) */

/*============================================================================
 *                     SCANNING DIRECTION MACROS
 *============================================================================*/

/** @brief  Scanning direction values (correspond to bits in ILI9488/ILI9806 MADCTL register 0x36) */
#define LCD_SCAN_LR_TB 0x00 /**< Left → right, top → bottom */
#define LCD_SCAN_LR_BT 0x80 /**< Left → right, bottom → top (MY=1) */
#define LCD_SCAN_RL_TB 0x40 /**< Right → left, top → bottom (MX=1) */
#define LCD_SCAN_RL_BT 0xC0 /**< Right → left, bottom → top (MY=1, MX=1) */
#define LCD_SCAN_TB_LR 0x20 /**< Top → bottom, left → right (MV=1) */
#define LCD_SCAN_TB_RL 0x60 /**< Top → bottom, right → left (MV=1, MX=1) */
#define LCD_SCAN_BT_LR 0xA0 /**< Bottom → top, left → right (MV=1, MY=1) */
#define LCD_SCAN_BT_RL 0xE0 /**< Bottom → top, right → left (MV=1, MY=1, MX=1) */

/** Common scanning modes */
#define LCD_SCAN_NORMAL LCD_SCAN_LR_TB  /**< Normal scanning direction */
#define LCD_SCAN_REVERSE LCD_SCAN_RL_BT /**< Full reverse scanning */

    /*============================================================================
     *                       FUNCTION PROTOTYPES
     *============================================================================*/

    /**
     * @defgroup XMC_lcd_exported_functions
     * @{
     */

    /* Initialization */
    void xmc_init(void); /**< Initialize XMC interface (must be called before lcd_init) */
    void lcd_init(void); /**< Initialize LCD controller (send init sequence) */

/* Low‑level command/data write */
#if LCD_USE8BIT_MODEL
    void lcd_wr_command(uint8_t command);
    void lcd_wr_data(uint8_t data);
#else
void lcd_wr_command(uint16_t command);
void lcd_wr_data(uint16_t data);
#endif

    /* Display area and pixel operations */
    void lcd_set_block(uint16_t xstart, uint16_t ystart, uint16_t xend, uint16_t yend);
    void lcd_write_one_point(uint16_t color);
    void lcd_draw_point(uint16_t x, uint16_t y, uint16_t color);
    void lcd_clear(uint16_t color);
    void lcd_fill(uint16_t x1, uint16_t y1, uint16_t x2, uint16_t y2, uint16_t color);

    /* Graphics primitives */
    void lcd_draw_line(uint16_t x_start, uint16_t y_start, uint16_t x_end, uint16_t y_end, uint16_t color);
    void lcd_draw_rectangle(uint16_t x1, uint16_t y1, uint16_t x2, uint16_t y2, uint16_t color);
    void lcd_draw_circle(uint16_t x0, uint16_t y0, uint16_t radius, uint16_t color);
    void lcd_fill_circle(uint16_t x0, uint16_t y0, uint16_t radius, uint16_t color);
    void lcd_fill_rectangle(uint16_t x1, uint16_t y1, uint16_t x2, uint16_t y2, uint16_t color);
    void lcd_draw_rounded_rect(uint16_t x1, uint16_t y1, uint16_t x2, uint16_t y2, uint16_t radius, uint16_t color);

    /* Text output */
    uint8_t lcd_show_ascii_char(uint16_t x, uint16_t y, char ch,
                                uint16_t color, uint16_t bg_color, AsciiFontSize font_size);
    void lcd_show_ascii_string(uint16_t x, uint16_t y, const char *str,
                               uint16_t color, uint16_t bg_color, AsciiFontSize font_size);
    uint16_t lcd_show_simple_number(uint16_t x, uint16_t y, int32_t num,
                                    uint16_t color, uint16_t bg_color, AsciiFontSize font_size);
    uint16_t lcd_show_number(uint16_t x, uint16_t y, int32_t num,
                             uint16_t color, uint16_t bg_color, AsciiFontSize font_size, uint8_t show_digits);
    uint16_t lcd_show_simple_float(uint16_t x, uint16_t y, float fnum,
                                   uint16_t color, uint16_t bg_color, AsciiFontSize font_size);
    uint16_t lcd_show_float_fixed(uint16_t x, uint16_t y, float fnum,
                                  uint16_t color, uint16_t bg_color, AsciiFontSize font_size,
                                  uint8_t int_digits, uint8_t decimal_digits);
    uint16_t lcd_show_float(uint16_t x, uint16_t y, float fnum,
                            uint16_t color, uint16_t bg_color, AsciiFontSize font_size, uint8_t decimal_digits);

    /* Image display */
    void lcd_show_internal_img(uint16_t x_start, uint16_t y_start,
                               uint16_t img_width, uint16_t img_height, const uint8_t *img_data);
    void lcd_show_internal_img_dma(uint16_t x_start, uint16_t y_start,
                                   uint16_t img_width, uint16_t img_height, const uint8_t *img_data);
    void lcd_show_flash_img(uint16_t x_start, uint16_t y_start, PicID picId);

    /* Utilities */
    void lcd_set_display_mode(uint8_t display_mode, uint8_t scan_mode);
    LCD_InfoType *LCD_GetInfo(void);
    uint16_t lcd_read_id(void);

/* DMA‑assisted functions (require DMA to be initialized) */
#if LCD_USE8BIT_MODEL
    void lcd_wr_data_dma(uint8_t *data, uint32_t length);
#else
void lcd_wr_data_dma(uint16_t *data, uint32_t length);
#endif

    void lcd_clear_dma(uint16_t color);
    void lcd_fill_dma(uint16_t x1, uint16_t y1, uint16_t x2, uint16_t y2, uint16_t color);

    /* DMA status flag – set by interrupt handler */
    extern volatile uint8_t lcd_dma_transfer_complete;

    /**
     * @}
     */

#ifdef __cplusplus
}
#endif

#endif /* __INF_LCD_H */