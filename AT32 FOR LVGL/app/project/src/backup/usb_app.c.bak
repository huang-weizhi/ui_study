/* add user code begin 1 */
error_status wk_usb_send_realtime_current(uint16_t current_ma)
{
  /* freertos_app.c 每10ms进来一次，这里只负责按照格式打包并发送。 */
  uint8_t candidate = (uint8_t)(realtime_active_buffer ^ 1U);
  uint8_t *frame = realtime_tx_buffer[candidate];
  uint16_t checksum;

  frame[0] = 0xCCU; /* 帧头，和上位机解析保持一致。 */
  frame[1] = 0xA5U;
  frame[2] = USB_REALTIME_FRAME_TYPE; /* 0x10 表示实时电流。 */
  usb_write_le16(&frame[3], 4U);
  usb_write_le16(&frame[5], realtime_sequence);
  usb_write_le16(&frame[7], USB_REALTIME_SAMPLE_PERIOD_MS); /* 固定10ms。 */
  usb_write_le16(&frame[9], current_ma);
  checksum = usb_checksum16(frame, USB_REALTIME_FRAME_SIZE - 2U);
  usb_write_le16(&frame[11], checksum);

  if(usb_vcp_send_data(&usb_core_dev, frame, USB_REALTIME_FRAME_SIZE) != SUCCESS)
  {
    /* USB 忙时本次数据丢掉，下一次10ms任务会继续发最新值。 */
    return ERROR;
  }

  realtime_active_buffer = candidate;
  realtime_sequence++;
  return SUCCESS;
}
/* add user code end 1 */
