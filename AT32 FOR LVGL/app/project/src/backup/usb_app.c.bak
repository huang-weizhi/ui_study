/* private variables ---------------------------------------------------------*/
/* add user code begin private variables */

static uint8_t realtime_tx_buffer[2][USB_REALTIME_FRAME_SIZE];
static uint8_t realtime_active_buffer = 1U;
static uint16_t realtime_sequence = 0U;

/* 两块缓冲交替轮流使用，避免USB正在发送时下一次组包把数据覆盖。 */

/* add user code end private variables */

/* private function prototypes --------------------------------------------*/
/* add user code begin function prototypes */

static void usb_write_le16(uint8_t *buffer, uint16_t value);
static uint16_t usb_checksum16(const uint8_t *buffer, uint16_t length);

/* add user code end function prototypes */

usbd_core_type usb_core_dev;

uint32_t usbd_app_buffer_fs1[128];

/* private user code ---------------------------------------------------------*/
/* add user code begin 0 */

static void usb_write_le16(uint8_t *buffer, uint16_t value)
{
  buffer[0] = (uint8_t)(value & 0xFFU);
  buffer[1] = (uint8_t)(value >> 8);
}

static uint16_t usb_checksum16(const uint8_t *buffer, uint16_t length)
{
  uint16_t checksum = 0U;

  while(length > 0U)
  {
    checksum = (uint16_t)(checksum + *buffer);
    buffer++;
    length--;
  }

  return checksum;
}

