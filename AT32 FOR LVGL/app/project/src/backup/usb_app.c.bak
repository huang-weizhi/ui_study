#define USB_REALTIME_FRAME_SIZE       13U
#define USB_REALTIME_FRAME_TYPE       0x10U
#define USB_REALTIME_SAMPLE_PERIOD_MS 10U

/* 帧格式：CC A5+类型+长度+序号+采样周期+电流值+校验和 */

