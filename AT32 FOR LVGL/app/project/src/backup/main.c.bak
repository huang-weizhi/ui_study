/**
  * @brief main function.
  * @param  none
  * @retval none
  */
int main(void)
{
  /* add user code begin 1 */
   nvic_vector_table_set(NVIC_VECTTAB_FLASH, 0x4000);
   Power_Global_Init();
   /* add user code end 1 */

  /* system clock config. */
  wk_system_clock_config();

  /* config periph clock. */
  wk_periph_clock_config();

  /* init debug function. */
  wk_debug_config();

  /* nvic config. */
  wk_nvic_config();

  /* timebase config for
     void wk_delay_ms(uint32_t delay); */
  wk_timebase_init();

  /* init gpio function. */
  wk_gpio_config();

  /* init wk_xmc_gpio function. */
  wk_xmc_gpio_init();

  /* init xmc_bank1_nor_sram1 function. */
  wk_xmc_bank1_nor_sram1_init();

  /* init crc function. */
  wk_crc_init();

  /* init wdt function. */
  wk_wdt_init();

  /* init exint function. */
  wk_exint_config();

  /* init dma1 channel3 */
  wk_dma1_channel3_init();
  /* config dma channel transfer parameter */
  /* user need to modify define values DMAx_CHANNELy_XXX_BASE_ADDR 
     and DMAx_CHANNELy_BUFFER_SIZE in at32xxx_wk_config.h */
  wk_dma_channel_config(DMA1_CHANNEL3, 
                        DMA1_CHANNEL3_PERIPHERAL_BASE_ADDR, 
                        DMA1_CHANNEL3_MEMORY_BASE_ADDR, 
                        DMA1_CHANNEL3_BUFFER_SIZE);
  dma_channel_enable(DMA1_CHANNEL3, TRUE);

  /* init spi4 function. */
  wk_spi4_init();

  /* init usart1 function. */
  wk_usart1_init();

  /* init tmr3 function. */
  wk_tmr3_init();

  /* add user code begin 2 */
   init_cycle_counter(true);
   EventRecorderInitialize(0, 1);
   lcd_init();
   lcd_clear(YELLOW);
   /* show logo */
   lcd_show_flash_img(198, 200, 0);
   wk_delay_ms(100);
   /* open lcd bl */
   tmr_channel_value_set(TMR3, TMR_SELECT_CHANNEL_1, 7999);
   
   /* wait for show logo end  */
   wk_delay_ms(2500);
   printf("system reday \r\n");
   check_flash_updata();

   /* add user code end 2 */

  /* init freertos function. */
  wk_freertos_init();

  while(1)
  {
    /* add user code begin 3 */
	  
	  
	  gpio_bits_toggle(OUT_LED_H_GPIO_PORT,OUT_LED_H_PIN);
      wk_delay_ms(1000);      
	  /* add user code end 3 */
  }
}

  /* add user code begin 4 */
void check_flash_updata(void)
{
   /* check flash updata */
   if (gpio_input_data_bit_read(IN_W25Q128_RE_H_GPIO_PORT, IN_W25Q128_RE_H_PIN))
   {
      spi_enable(SPI4, FALSE);
      lcd_clear(BLACK);
      lcd_show_ascii_string(310, 200, (char *)"updata flash....", RED, BLACK, FONT_16X8);
   }
   while (gpio_input_data_bit_read(IN_W25Q128_RE_H_GPIO_PORT, IN_W25Q128_RE_H_PIN))
      ;
   spi_enable(SPI4, TRUE);
}
/* add user code end 4 */
