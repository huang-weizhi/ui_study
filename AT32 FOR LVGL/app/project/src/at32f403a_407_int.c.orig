extern void xPortSysTickHandler(void);

/**
  * @brief  this function handles systick handler.
  * @param  none
  * @retval none
  */
void SysTick_Handler(void)
{
  /* add user code begin SysTick_IRQ 0 */
  EC11_TickInc();
  EC11_KeyScan(&g_ec11_1);
  EC11_KeyScan(&g_ec11_2);
  /* add user code end SysTick_IRQ 0 */

#if (INCLUDE_xTaskGetSchedulerState == 1 )
  if (xTaskGetSchedulerState() != taskSCHEDULER_NOT_STARTED)
  {
#endif /* INCLUDE_xTaskGetSchedulerState */
  xPortSysTickHandler();
#if (INCLUDE_xTaskGetSchedulerState == 1 )
  }
#endif /* INCLUDE_xTaskGetSchedulerState */

  /* add user code begin SysTick_IRQ 1 */

  /* add user code end SysTick_IRQ 1 */
}

/**
  * @brief  this function handles DMA1 Channel 3 handler.
  * @param  none
  * @retval none
  */
void DMA1_Channel3_IRQHandler(void)
{
  /* add user code begin DMA1_Channel3_IRQ 0 */

  /* add user code end DMA1_Channel3_IRQ 0 */

  if(dma_interrupt_flag_get(DMA1_FDT3_FLAG) != RESET)
  {   
    /* add user code begin DMA1_FDT3_FLAG */
    /* handle full data transfer and clear flag */
    dma_flag_clear(DMA1_FDT3_FLAG);
    dma_channel_enable(LCD_DMA_CHANNEL, FALSE);
    lcd_dma_transfer_complete = 1;
    /* add user code end DMA1_FDT3_FLAG */ 
  }

  /* add user code begin DMA1_Channel3_IRQ 1 */

  /* add user code end DMA1_Channel3_IRQ 1 */
}

/**
  * @brief  this function handles DMA1 Channel 4 handler.
  * @param  none
  * @retval none
  */
void DMA1_Channel4_IRQHandler(void)
{
  /* add user code begin DMA1_Channel4_IRQ 0 */
  BaseType_t xHigherPriorityTaskWoken = pdFALSE;
  /* add user code end DMA1_Channel4_IRQ 0 */

  if(dma_interrupt_flag_get(DMA1_FDT4_FLAG) != RESET)
  {   
    /* add user code begin DMA1_FDT4_FLAG */
	  
	  if (!sps3006.flash_updata)
	  {
	          UBaseType_t uxStateA = taskENTER_CRITICAL_FROM_ISR();
    for (uint8_t ch = 0; ch < ADC_CH_NUM; ch++)
    {
      sample_buffer[sample_cnt][ch] = sps3006.adc_raw_buff[ch];
    }
    sample_cnt++;

    if (sample_cnt >= FILTER_TIMES)
    {

      for (uint8_t ch = 0; ch < ADC_CH_NUM; ch++)
      {

        uint16_t max_val = sample_buffer[0][ch];
        uint16_t min_val = sample_buffer[0][ch];
        uint32_t sum = 0;

        for (uint8_t i = 0; i < FILTER_TIMES; i++)
        {
          uint16_t val = sample_buffer[i][ch];
          if (val > max_val)
            max_val = val;
          if (val < min_val)
            min_val = val;
          sum += val;
        }

        uint16_t filtered = (sum - max_val - min_val) / (FILTER_TIMES - 2);
        sps3006.adc_raw_buff[ch] = filtered;
      }

      sps3006.usb.vbus = (float)sps3006.adc_raw_buff[0] / 100.0f;
      sps3006.usb.dp = (float)sps3006.adc_raw_buff[1] / 100.0f;
      sps3006.usb.dm = (float)sps3006.adc_raw_buff[2] / 100.0f;
      sps3006.usb.ibus = (float)sps3006.adc_raw_buff[3] / 1000.0f;
      sps3006.typec.vbus = (float)sps3006.adc_raw_buff[4] / 100.0f;
      sps3006.typec.dm = (float)sps3006.adc_raw_buff[5] / 100.0f;
      sps3006.typec.cc2 = (float)sps3006.adc_raw_buff[6] / 100.0f;
      sps3006.typec.ibus = (float)sps3006.adc_raw_buff[7] / 1000.0f;
      
      sps3006.output_current_from_mcu = (float)sps3006.adc_raw_buff[8] / 0.68267f;
      if (sps3006.output_current_from_mcu < 0)
        sps3006.output_current_from_mcu = 0;
	  
	  sps3006.output_voltage = (float)sps3006.adc_raw_buff[9] / 100.0f;
	  
      sps3006.ntc_temperature = (float)sps3006.adc_raw_buff[10];
      sps3006.typec.dp = (float)sps3006.adc_raw_buff[11] / 100.0f;
      sps3006.typec.cc1 = (float)sps3006.adc_raw_buff[12] / 100.0f;

      sample_cnt = 0;
    }
    taskEXIT_CRITICAL_FROM_ISR(uxStateA);
	  }
    /* handle full data transfer and clear flag */

    dma_flag_clear(DMA1_FDT4_FLAG);

    /* add user code end DMA1_FDT4_FLAG */ 
  }

  /* add user code begin DMA1_Channel4_IRQ 1 */

  /* add user code end DMA1_Channel4_IRQ 1 */
}

